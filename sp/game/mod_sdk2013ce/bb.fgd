@include "halflife2.fgd"

@NPCClass base(BaseHelicopter) studio("models/combine_dropship.mdl" ) = npc_combinedropship : "Combine Dropship"
[
	spawnflags(Flags) =
	[
		32768 : "Wait for input before dropoff" : 0
	]

	LandTarget(target_destination) : "Land target name"
	GunRange(float) : "Crate Gun Range" : 2048 : "If the dropship's carrying a crate with a gun on it, it'll only shoot targets within this range."

	RollermineTemplate(target_destination) : "Name of Rollermine Template" : "" : "If this dropship drops any rollermines due to the 'DropMines' input being fired, it will use this template for the rollermines it creates. If left blank, ordinary rollermines will be dropped."

	NPCTemplate(target_destination) : "Name of Template NPC 1"
	NPCTemplate2(target_destination) : "Name of Template NPC 2"
	NPCTemplate3(target_destination) : "Name of Template NPC 3"
	NPCTemplate4(target_destination) : "Name of Template NPC 4"
	NPCTemplate5(target_destination) : "Name of Template NPC 5"
	NPCTemplate6(target_destination) : "Name of Template NPC 6"

	Dustoff1(target_destination) : "Name of dustoff point for NPC 1"
	Dustoff2(target_destination) : "Name of dustoff point for NPC 2"
	Dustoff3(target_destination) : "Name of dustoff point for NPC 3"
	Dustoff4(target_destination) : "Name of dustoff point for NPC 4"
	Dustoff5(target_destination) : "Name of dustoff point for NPC 5"
	Dustoff6(target_destination) : "Name of dustoff point for NPC 6"

	APCVehicleName(target_destination) : "Name of the APC to drop"
	Invulnerable(Choices) : "Invulnerable" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]

	CrateType(Choices) : "Crate Type" : 2 =
	[
		-4 : "Jalopy (No crate)"
		-3 : "Jeep (No crate)"
		-2 : "APC (No crate)"
		-1 : "Strider (No crate)"
		0 : "Roller Hopper"
		1 : "Soldier Crate"
		2 : "None"
	]

	// Inputs
	input LandLeaveCrate(integer) : "Land, drop soldiers, and leave the crate behind. Specify the number of troops to drop off in the parameter."
	input LandTakeCrate(integer) : "Land, drop soldiers, but don't leave the crate behind. Specify the number of troops to drop off in the parameter."
	input DropMines(integer) : "Drop Rollermines. Specify the number of mines to drop in the parameter."
	input DropStrider(void) : "Drop the Strider you're carrying. Now."
	input DropAPC(void) : "Drop the APC you're carrying. Now."
	input Hover(target_destination) : "Hover over a named target entity until told to fly to a path."
	input Pickup(string) : "Pickup an entity."
	input SetLandTarget(string) : "Set my land target name."
	input SetGunRange(float) : "Set my crate gun's range."

	input EnableRotorSound(void) : "Turns on rotor sounds"
	input DisableRotorSound(void) : "Turns off rotor sounds"

	input StopWaitingForDropoff(void) : "Stop waiting for the dropoff. Dropoff as soon as possible."


	// Outputs
	output OnFinishedDropoff(void)  : "Fires when the dropship has finished a dropoff."
	output OnFinishedPickup(void) : "Fires when the dropship has finished a pickup."

	output OnCrateShotDownBeforeDropoff(float) : "Fires when the container was shot down before it dropped off soldiers. The parameter contains the number of soldiers that weren't successfully dropped off."
	output OnCrateShotDownAfterDropoff(void) : "Fires when the container was shot down after it dropped off soldiers."

]

@PointClass base(BaseDriveableVehicle) studioprop() = prop_vehicle_jalopy :
	"Driveable studiomodel jalopy."
[
	input StartRemoveTauCannon(void) : "Start the tau removal sequence."
	input FinishRemoveTauCannon(void) : "Finish the tau removal sequence."

	// FIXME: These will move into episodic
	input LockEntrance( void ) : "Stops NPC's from entering the vehicle until unlocked."
	input UnlockEntrance( void ) : "Allows NPC's to enter the vehicle."
	input LockExit( void ) : "Stops NPC's from exiting the vehicle until unlocked."
	input UnlockExit( void ) : "Allows NPC's to exit the vehicle."
	input EnableRadar( void ) : "Turn on the Jalopy radar"
	input DisableRadar( void ) : "Turn off the Jalopy radar"
	input EnableRadarDetectEnemies( void ) : "Enable Jalopy radar to detect Striders and Hunters"
	input AddBusterToCargo( void ) : "Put a striderbuster in the cargo trigger"
	input SetCargoHopperVisibility ( bool ) : "Set the strider buster hopper thingy to be visible, or invisible."

	input DisablePhysGun(void) : "Disable physgun interactions with the jeep."
	input EnablePhysGun(void) : "Enable physgun interactions with the jeep (default)."

	input CreateLinkController(void) : "Automatically builds and attaches a link controller to the car, which cuts the node connections under the car while the car is standing still."
	input DestroyLinkController(void) : "Destroys the link controller created by CreateLinkController."


	CargoVisible(choices): "Hopper Visible" : 0 : "Is the striderbuster cargo hopper visible?" =
	[
		0 : "No"
		1 : "Yes"
	]

	spawnflags(Flags) =
	[
		1 : "HUD Locator Precache" : 0
	]


	// FIXME: These are going to change!
	output OnCompanionEnteredVehicle(void) : "Companion has entered the vehicle."
	output OnCompanionExitedVehicle(void) : "Companion has exited the vehicle."
	output OnHostileEnteredVehicle(void) : "Hostile has entered the vehicle."
	output OnHostileExitedVehicle(void) : "Hostile has exited the vehicle."
]

@PointClass base(Targetname) studio("models/props_lab/keypad.mdl") = prop_keypad : "An interactive keypad that fires outputs depending if is correct " +
"or not the introduced code."
[
	code(string) : "Code (MAX 4!)" : "1234"
	label(string) : "Label" : "Mah keypad"
	hide_pass(choices) : "Hide password?" : "1" =
	[
		"0" : "No"
		"1": 	"Yes"
	]

	input Enable(void) : "Enables the keypad."

	output OnCorrectCode(void) : "Fired when the code is correct."
	output OnIncorrectCode(void) : "Fired when the code is incorrect."
]

//-------------------------------------------------------------------------
// [Mapbase port] weapon_slam — Selectable Lightweight Attack Munition.
//   Re-enabled in singleplayer (see [Mapbase port] commit 'Re-enable
//   weapon_slam in singleplayer'). Models live in HL2 Anniversary VPK.
//-------------------------------------------------------------------------
@PointClass base(Weapon) studio("models/weapons/w_slam.mdl") = weapon_slam :
	"S.L.A.M. — secondary fire attaches a tripmine to a wall, primary fire " +
	"throws or attaches a satchel charge that can be detonated remotely."
[
]

//-------------------------------------------------------------------------
// [Mapbase port] env_instructor_hint — places a Game Instructor hint that
//   the player sees as a HUD icon + caption. Fire ShowHint to display.
//-------------------------------------------------------------------------
@PointClass base(Targetname) iconsprite("editor/env_microphone.vmt") = env_instructor_hint :
	"An entity for creating Game Instructor hints (HUD icon + caption) " +
	"entirely from map I/O. Send 'ShowHint' to display, 'EndHint' to dismiss."
[
	hint_replace_key(string)         : "Replace Key"           : "" : "Hints with the same replace key will replace each other instead of stacking."
	hint_target(target_destination)  : "Hint Target"           : "" : "Entity the hint icon will hover over. Defaults to this env_instructor_hint."
	hint_timeout(integer)            : "Timeout (sec, 0 = forever)" : 0 : "How long the hint stays visible before auto-closing. 0 = no timeout."

	hint_icon_onscreen(string)       : "Onscreen Icon"         : "icon_tip" : "Icon shown when the target is in view (e.g. icon_tip, icon_use, icon_alert)."
	hint_icon_offscreen(string)      : "Offscreen Icon"        : "icon_tip" : "Icon shown as a directional arrow when the target is offscreen."

	hint_caption(string)             : "Caption"               : "" : "Localization token (#FOO_BAR) or literal text shown next to the icon."
	hint_activator_caption(string)   : "Activator Caption"     : "" : "Alternate caption shown to the entity that triggered ShowHint, if different from the global caption."
	hint_color(color255)             : "Caption Color"         : "255 255 255" : "RGB color of the caption text."

	hint_icon_offset(float)          : "Icon Offset"           : "0.0" : "World units to offset the icon above the target's origin."
	hint_range(float)                : "Visible Range"         : "0.0" : "If non-zero, hint only shows when the player is within this distance."

	hint_pulseoption(choices)        : "Icon Pulse"            : 0 =
	[
		0 : "None"
		1 : "Slow"
		2 : "Fast"
		3 : "Urgent"
	]
	hint_alphaoption(choices)        : "Icon Alpha Pulse"      : 0 =
	[
		0 : "None"
		1 : "Slow"
		2 : "Fast"
		3 : "Urgent"
	]
	hint_shakeoption(choices)        : "Icon Shake"            : 0 =
	[
		0 : "None"
		1 : "Narrow"
		2 : "Wide"
	]

	hint_static(choices)             : "Static (fixed HUD pos)" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	hint_nooffscreen(choices)        : "Hide Offscreen Icon"   : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	hint_forcecaption(choices)       : "Force Caption"         : 0 =
	[
		0 : "No"
		1 : "Yes (caption shows even when icon is occluded)"
	]
	hint_allow_nodraw_target(choices) : "Allow Nodraw Target"  : 1 =
	[
		0 : "No"
		1 : "Yes"
	]
	hint_local_player_only(choices)  : "Local Player Only"     : 1 =
	[
		0 : "No"
		1 : "Yes"
	]

	hint_binding(string)             : "Binding to Display"    : "" : "If set, shows the player's current key binding for this command instead of a static icon (e.g. +use, +jump)."

	// Inputs
	input ShowHint(string)           : "Show this hint to the player. Optional string parameter sets the hint name (used by replace_key)."
	input EndHint(void)               : "Dismiss this hint."
]

//-------------------------------------------------------------------------
// Ported Mapbase AI / logic entities
//-------------------------------------------------------------------------

@PointClass base(Targetname, EnableDisable) iconsprite("editor/ai_relationship.vmt") = ai_weaponmodifier :
	"Overrides the burst/rest timing (shot regulator) of the target NPCs' weapons while enabled. " +
	"Ranges are written as 'min:max' in seconds. Up to 16 NPCs at once."
[
	target(target_destination) : "Target NPC(s)" : "" : "NPCs to modify when enabled. Wildcards allowed."
	BurstInterval(string) : "Burst interval" : "" : "Time between shots inside a burst, 'min:max'."
	RestInterval(string) : "Rest interval" : "" : "Pause between bursts, 'min:max'."
	BurstShotCountRange(string) : "Burst shot count" : "" : "Shots per burst, 'min:max'."
	BurstShotsRemaining(integer) : "Burst shots remaining" : 0 : "Shots left in the current burst."

	input EnableOnNPC(target_destination) : "Apply the modifier to this NPC."
	input DisableOnNPC(target_destination) : "Restore this NPC's original regulator."
	input SetBurstInterval(string) : "Set the burst interval, 'min:max'."
	input SetRestInterval(string) : "Set the rest interval, 'min:max'."
	input SetBurstShotCountRange(string) : "Set the shots per burst, 'min:max'."
	input SetBurstShotsRemaining(integer) : "Set shots left in the current burst."
	input EnableShooting(void) : "Allow the modified NPCs to shoot."
	input DisableShooting(void) : "Stop the modified NPCs from shooting."
	input FireNoEarlierThan(float) : "Don't shoot for this many seconds."
	input Reset(bool) : "Reset the regulator. 1 = start with a rest."
]

@PointClass base(Targetname, EnableDisable) iconsprite("editor/ai_relationship.vmt") = ai_monitor :
	"Watches NPCs for conditions, schedules or hint usage and fires outputs. " +
	"Lists are colon-separated, e.g. 'COND_SEE_ENEMY:COND_LIGHT_DAMAGE'."
[
	target(target_destination) : "Target NPC(s)" : "" : "NPCs to watch. Wildcards allowed."
	MaxEnts(integer) : "Max NPCs" : 0 : "How many matching NPCs to watch. 0 = no limit."
	SetMonitorInterval(float) : "Monitor interval" : "0" : "Seconds between checks. 0 = every tick."
	SetCooldownTime(float) : "Cooldown" : "0" : "Extra wait after a successful check. -1 = same as the monitor interval."
	CooldownAt(choices) : "Stop at first success" : 0 : "Stop evaluating the remaining NPCs once one passes." =
	[
		0 : "No, check every NPC"
		1 : "Yes"
	]
	Conditions(string) : "Conditions" : "" : "Condition names (or IDs) to watch."
	Schedules(string) : "Schedules" : "" : "Schedule names (or IDs) to watch."
	TranslateSchedules(boolean) : "Translate schedules" : 0 : "Translate each schedule through the NPC's own schedule overrides before comparing."
	Hints(string) : "Hint types" : "" : "Hint type numbers to watch."
	HintDistance(float) : "Hint distance" : "0" : "Only count a hint as used when the NPC is within this distance of it. 0 = any distance."

	input UpdateActors(void) : "Re-find the target NPCs."
	input Test(void) : "Evaluate all watched NPCs now."
	input TestNPC(target_destination) : "Evaluate this NPC now."
	input GetConditionName(integer) : "Fire OutConditionName with the name of this condition ID."
	input GetScheduleName(integer) : "Fire OutScheduleName with the name of this schedule ID."
	input SetCondition(string) : "Start watching a condition."
	input ClearCondition(string) : "Stop watching a condition."
	input ClearAllConditions(void) : "Stop watching all conditions."
	input SetSchedule(string) : "Start watching a schedule."
	input ClearSchedule(string) : "Stop watching a schedule."
	input ClearAllSchedules(void) : "Stop watching all schedules."
	input SetHint(integer) : "Start watching a hint type."
	input ClearHint(integer) : "Stop watching a hint type."
	input ClearAllHints(void) : "Stop watching all hint types."
	input SetMonitorInterval(float) : "Set seconds between checks."
	input SetCooldownTime(float) : "Set the cooldown."

	output OutConditionName(string) : "Name of an evaluated or requested condition."
	output OutScheduleName(string) : "Name of an evaluated or requested schedule."
	output OnNPCHasCondition(integer) : "An NPC has a watched condition (passes its ID). Activator is the NPC."
	output OnNPCLacksCondition(integer) : "An NPC lacks a watched condition (passes its ID)."
	output OnNPCRunningSchedule(integer) : "An NPC runs a watched schedule (passes its ID)."
	output OnNPCNotRunningSchedule(integer) : "An NPC doesn't run a watched schedule (passes its ID)."
	output OnNPCUsingHint(integer) : "An NPC uses a hint of a watched type (passes the type)."
	output OnNPCNotUsingHint(integer) : "An NPC doesn't use a hint of a watched type (passes the type)."
]

@PointClass base(Targetname) iconsprite("editor/logic_auto.vmt") = logic_skill :
	"Fires outputs for the current difficulty."
[
	ListenForSkillChange(boolean) : "Listen for skill changes" : 1 : "Fire OnSkillChanged when the difficulty changes mid-game."

	input Test(void) : "Fire OnEasy, OnNormal or OnHard for the current difficulty."
	input StartListening(void) : "Start firing OnSkillChanged."
	input StopListening(void) : "Stop firing OnSkillChanged."

	output OnSkillChanged(integer) : "Difficulty changed (1 easy, 2 normal, 3 hard)."
	output OnEasy(void) : "Test: the difficulty is easy."
	output OnNormal(void) : "Test: the difficulty is normal."
	output OnHard(void) : "Test: the difficulty is hard."
]

//-------------------------------------------------------------------------
// Half-Life: BB - suspicion of the player (ai_suspicion.h). Replaces the
// "gordon_precriminal" global: metrocops and Combine soldiers ignore the player
// until they see him armed or in a trigger_restricted_area long enough (or he
// hurts them). Scanners, spotlights and vehicle drivers turn hostile while a
// hostile cop or soldier is within radio range.
//-------------------------------------------------------------------------

@PointClass base(Targetname) iconsprite("editor/ai_relationship.vmt") = ai_suspicion_manager :
	"Optional. Switches the suspicion system for this map and reports the overall alert level. " +
	"Use at most one per map. Tuning lives in the ai_suspicion_* console variables."
[
	StartDisabled(boolean) : "Start Disabled" : 0 : "Disabled: the Combine treat the player as an enemy, as in HL2."

	input Enable(void) : "Turn the suspicion system on."
	input Disable(void) : "Turn it off: the Combine treat the player as an enemy, as in HL2."
	input MakePlayerHostile(void) : "Every participating NPC turns hostile and learns where the player is."
	input CalmAll(void) : "Every participating NPC forgets its suspicion."

	output OnPlayerSuspicious(void) : "The first NPC grew suspicious while all were calm. Activator is the NPC."
	output OnPlayerHostile(void) : "The first NPC turned hostile. Activator is the NPC."
	output OnAllCalm(void) : "No NPC is suspicious or hostile anymore."
]

@SolidClass base(Trigger) = trigger_restricted_area :
	"Area the player isn't allowed in. Metrocops and Combine soldiers who see him inside grow suspicious " +
	"(or turn hostile at once with 'Hostile on sight')."
[
	SuspicionRate(float) : "Suspicion per second" : "0.5" : "Added per second while an NPC sees the player inside (full rate up close, less at range). Adds to the weapon rate."
	Hostile(boolean) : "Hostile on sight" : 0 : "Being seen inside turns the NPC hostile immediately."

	output OnPlayerSpotted(void) : "An NPC saw the player inside (at most every 3 seconds). Activator is the NPC."
]
